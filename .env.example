# ===== LLM（必填）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=deepseek-chat
# 可选：输入输出均价（元/百万 tokens），填了才会显示成本估算
PRICE_PER_MTOK=

# ===== 你的画像（决定打分准不准，比源还重要）=====
# 写得越具体越好：你现在在做什么、要找什么、什么程度的内容算"能上手"
PROFILE=大三学生，嵌入式与计算机视觉背景（C++/OpenCV），目标 2027 年进入 AI 应用工程岗。当前在做：LLM 应用的工程化实践（信息采集、结构化输出、评测、成本控制）。关注：Agent 工具调用与工作流编排、上下文工程、RAG 与评测方法、多模态模型在视觉任务上的落地、AI 工程岗位与实习机会。看不上：泛泛的行业展望、纯观点文、消费电子评测。

# ===== 信息源（逗号分隔）=====
# 选源原则：宁可 3 个高质量来源，不要 20 个杂源。
# 以下是实测可用的组合：
FEEDS=https://simonwillison.net/atom/everything/,https://hnrss.org/newest?q=LLM+OR+agent&points=100,https://www.latent.space/feed,https://mshibanami.github.io/GitHubTrendingRSS/daily/python.xml,https://www.infoq.cn/feed

# 备选（按需取消注释合并到上面）：
#   https://openai.com/news/rss.xml                                    官方发布，量大要限量
#   http://export.arxiv.org/rss/cs.CL                                  论文，应用岗慎用
#   https://www.ruanyifeng.com/blog/atom.xml                           泛技术周刊
#   https://sspai.com/feed                                             消费数码，慎用

# ===== 推送渠道（可选，配一个就够）=====
# 推荐：企业微信群机器人。建一个只有自己的群 → 群设置 → 群机器人 → 添加 → 复制 Webhook 地址
#   WEBHOOK_TYPE 可选 wecom / feishu / dingtalk / raw
WEBHOOK_TYPE=wecom
WEBHOOK_URL=

# 邮件（QQ/163 的 SMTP_PASS 填「授权码」，不是登录密码）
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
MAIL_TO=
